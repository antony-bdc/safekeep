[Unit]
Description=safekeep: weekly restore test
After=safekeep.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/safekeep restore-test
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter /run/lock /root/.cache/restic /tmp
PrivateTmp=true
NoNewPrivileges=true
