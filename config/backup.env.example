# /etc/safekeep/backup.env  (chmod 600, owned by root)

# Where backups go. Any restic backend works:
#   local disk:  /mnt/backup/restic
#   SFTP:        sftp:backup@nas.lan:/srv/restic
#   S3/B2:       s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/host
RESTIC_REPOSITORY="/mnt/backup/restic"
RESTIC_PASSWORD_FILE="/etc/safekeep/restic.password"

# Space-separated list of paths to back up.
BACKUP_PATHS="/etc /home /srv"
EXCLUDE_FILE="/etc/safekeep/excludes.txt"
BACKUP_TAG="$(hostname -s)"

# Retention
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Restore test: how many random files to restore and verify
RESTORE_TEST_FILES=20

# Prometheus node_exporter textfile collector (see observatory)
METRICS_DIR="/var/lib/node_exporter/textfile_collector"

# Optional: dead-man's switch (e.g. healthchecks.io) and failure alerts
HEALTHCHECK_URL=""
DISCORD_WEBHOOK_URL=""
